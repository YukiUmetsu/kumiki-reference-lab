{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/contact-sheet.schema.json",
  "title": "Kumiki Contact Sheet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "settings", "sourceTimebase", "coverage", "cutCandidatePts", "evidenceFrames", "indexSha256"],
  "properties": {
    "schemaVersion": {"const": "kumiki.contact-sheet.v1"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "sourceStreamIndex", "seconds", "limit", "width", "cutThreshold", "ffmpeg", "ffprobe", "samplingAlgorithm"],
      "properties": {
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceStreamIndex": {"type": "integer", "minimum": 0},
        "seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "limit": {"type": "integer", "minimum": 2, "maximum": 24},
        "width": {"type": "integer", "minimum": 128, "maximum": 800},
        "cutThreshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "ffmpeg": {"type": "string"},
        "ffprobe": {"type": "string"},
        "samplingAlgorithm": {"const": "cut-pairs-and-farthest-ordinals-v1"}
      }
    },
    "sourceTimebase": {"$ref": "#/$defs/rational"},
    "coverage": {"const": "bounded-from-start-not-necessarily-full-video"},
    "cutCandidatePts": {"type": "array", "items": {"type": "integer"}},
    "evidenceFrames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sampleOrdinal", "sourcePts", "sourceSeconds", "roles", "image", "sha256"],
        "properties": {
          "sampleOrdinal": {"type": "integer", "minimum": 0},
          "sourcePts": {"type": "integer"},
          "sourceSeconds": {"$ref": "#/$defs/rational"},
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["opening", "closing", "cut-before", "cut-after", "overview"]}
          },
          "image": {"type": "string", "pattern": "^frame-[0-9]{3}\\.jpg$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "indexSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
