{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/schemas/v1/source-manifest.schema.json",
  "title": "Kumiki Source Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "video", "timestamps", "analysis"],
  "properties": {
    "schemaVersion": {"const": "kumiki.source-manifest.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256", "rightsStatus"],
      "properties": {
        "fileName": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rightsStatus": {"enum": ["review-required", "user-declared-authorized"]}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streamIndex", "codec", "width", "height", "averageFrameRate", "nominalFrameRate", "sourceTimebase", "durationSecondsReported"],
      "properties": {
        "streamIndex": {"type": "integer", "minimum": 0},
        "codec": {"type": ["string", "null"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "averageFrameRate": {"$ref": "#/$defs/nullableRational"},
        "nominalFrameRate": {"$ref": "#/$defs/nullableRational"},
        "sourceTimebase": {"$ref": "#/$defs/rational"},
        "durationSecondsReported": {"type": ["string", "null"]}
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUnit", "originalFramePtsExtracted", "frameRateMode", "outputMapping"],
      "properties": {
        "sourceUnit": {"const": "stream-timebase-ticks"},
        "originalFramePtsExtracted": {"const": false},
        "frameRateMode": {"const": "unknown-until-source-pts-are-inspected"},
        "outputMapping": {"const": "not-performed"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "frameAnalysisPerformed"],
      "properties": {
        "method": {"const": "ffprobe-metadata"},
        "frameAnalysisPerformed": {"const": false}
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "nullableRational": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]}
  }
}
