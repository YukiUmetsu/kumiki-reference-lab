{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/edit-rhythm.schema.json",
  "title": "Kumiki Candidate Edit Rhythm Observations v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "analysisRunSha256", "sourceStreamIndex", "sourceTimebase", "videoCutCandidateCount", "observedInterCutIntervalCount", "status", "intervals", "durationRangeSeconds", "censoring", "cutStatus", "qualityVerdict", "limits"],
  "properties": {
    "schemaVersion": {"const": "kumiki.edit-rhythm.v1"},
    "sourceSha256": {"$ref": "#/$defs/hash"},
    "analysisRunSha256": {"$ref": "#/$defs/hash"},
    "sourceStreamIndex": {"type": "integer", "minimum": 0},
    "sourceTimebase": {"$ref": "#/$defs/rational"},
    "videoCutCandidateCount": {"type": "integer", "minimum": 0},
    "observedInterCutIntervalCount": {"type": "integer", "minimum": 0},
    "status": {"enum": ["bounded-candidate-inter-cut-intervals", "insufficient-candidate-cuts-for-inter-cut-intervals"]},
    "intervals": {
      "type": "array", "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["regionId", "fromVideoCutCandidatePts", "toVideoCutCandidatePts", "fromSeconds", "toSeconds", "durationSeconds", "durationRatioToPrevious", "changeVsPrevious", "interpretationStatus"],
        "properties": {
          "regionId": {"type": "string", "pattern": "^region-[0-9]{3}$"},
          "fromVideoCutCandidatePts": {"type": "integer"},
          "toVideoCutCandidatePts": {"type": "integer"},
          "fromSeconds": {"$ref": "#/$defs/rational"},
          "toSeconds": {"$ref": "#/$defs/rational"},
          "durationSeconds": {"$ref": "#/$defs/rational"},
          "durationRatioToPrevious": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
          "changeVsPrevious": {"enum": ["not-applicable-first-interval", "shorter", "longer", "same"]},
          "interpretationStatus": {"const": "not-performed"}
        }
      }
    },
    "durationRangeSeconds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "median", "maximum"],
      "properties": {
        "minimum": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "median": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "maximum": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]}
      }
    },
    "censoring": {"const": "scan-start-may-be-mid-shot;final-region-has-no-verified-end"},
    "cutStatus": {"const": "algorithmic-hard-cut-candidates-not-verified-edits"},
    "qualityVerdict": {"const": "not-performed"},
    "limits": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rational": {"type": "object", "additionalProperties": false,
                 "required": ["numerator", "denominator"],
                 "properties": {"numerator": {"type": "integer"},
                                "denominator": {"type": "integer", "minimum": 1}}}
  }
}
