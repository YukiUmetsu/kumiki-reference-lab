{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/cinematic-technique.schema.json",
  "title": "Kumiki Cinematic Technique Research Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "category", "name", "status", "summary", "intent", "mechanism", "recipe", "parameters", "evidence", "kumiki", "qa"],
  "properties": {
    "schemaVersion": {"const": "kumiki.cinematic-technique.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "category": {"enum": ["story", "attention", "camera", "lighting", "motion", "editing", "materials", "typography", "sound"]},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["research-candidate", "implementation-proposed", "implemented", "verified"]},
    "summary": {"type": "string", "minLength": 1},
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["storyPurposes", "viewerQuestion", "desiredPerceptualResult", "avoidWhen"],
      "properties": {
        "storyPurposes": {"$ref": "#/$defs/strings"},
        "viewerQuestion": {"type": "string", "minLength": 1},
        "desiredPerceptualResult": {"type": "string", "minLength": 1},
        "avoidWhen": {"$ref": "#/$defs/strings"}
      }
    },
    "mechanism": {
      "type": "object", "additionalProperties": false,
      "required": ["visibleCues", "plausibleCauses", "unknowns"],
      "properties": {
        "visibleCues": {"$ref": "#/$defs/strings"},
        "plausibleCauses": {"$ref": "#/$defs/strings"},
        "unknowns": {"$ref": "#/$defs/strings"}
      }
    },
    "recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["beats", "craftNotes", "fallback"],
      "properties": {
        "beats": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "start", "end", "direction", "attentionTarget"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0, "maximum": 1},
              "end": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "direction": {"type": "string", "minLength": 1},
              "attentionTarget": {"type": "string", "minLength": 1}
            }
          }
        },
        "craftNotes": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "fallback": {"type": "string", "minLength": 1}
      }
    },
    "parameters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "unit", "min", "max", "authoredDefault", "visualImpact", "failureSigns"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "authoredDefault": {"type": "number"},
          "visualImpact": {"type": "string", "minLength": 1},
          "failureSigns": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "evidence": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceSha256", "artifact", "sourcePts", "observation", "method"],
        "properties": {
          "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact": {"type": "string", "minLength": 1},
          "sourcePts": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "observation": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1}
        }
      }
    },
    "kumiki": {
      "type": "object", "additionalProperties": false,
      "required": ["registryId", "implementationStatus", "adapterNotes"],
      "properties": {
        "registryId": {"type": ["string", "null"]},
        "implementationStatus": {"enum": ["not-implemented", "in-progress", "implemented", "reviewed"]},
        "adapterNotes": {"type": "string", "minLength": 1}
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptanceChecks", "humanApproved", "referenceCompared"],
      "properties": {
        "acceptanceChecks": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "humanApproved": {"type": "boolean"},
        "referenceCompared": {"type": "boolean"}
      }
    }
  },
  "$defs": {"strings": {"type": "array", "minItems": 1, "uniqueItems": true,
    "items": {"type": "string", "minLength": 1}}}
}
