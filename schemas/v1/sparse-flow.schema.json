{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/sparse-flow.schema.json",
  "title": "Kumiki Sparse Image-Plane Flow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "sourceStreamIndex", "sourceTimebase", "scanWindowSeconds", "coverage", "analyzer", "cutCandidatePts", "samples", "pairs"],
  "allOf": [{
    "if": {"properties": {"analyzer": {"properties": {
      "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-v1"]}
    }}}},
    "then": {"properties": {"pairs": {"items": {"properties": {
      "vectors": {"items": {"properties": {
        "dx": {"type": "integer"}, "dy": {"type": "integer"}
      }}}
    }}}}}
  }, {
    "if": {"properties": {"analyzer": {"properties": {
      "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-affine-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-bidir-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-bidir-v1"]}
    }}}},
    "then": {"properties": {
      "analyzer": {"required": ["affineInlierTolerancePixels", "affineMaxHypotheses"]},
      "pairs": {"items": {"required": ["geometryHypothesis"]}}
    }}
  }, {
    "if": {"properties": {"analyzer": {"properties": {
      "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-bidir-v1"]}
    }}}},
    "then": {"properties": {
      "analyzer": {"required": ["pyramidLevels", "coarseRefinementRadiusPixels"]},
      "pairs": {"items": {"properties": {
        "vectors": {"items": {"required": ["searchLevel"]}}
      }}}
    }}
  }, {
    "if": {"properties": {"analyzer": {"properties": {
      "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-bidir-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-bidir-v1"]}
    }}}},
    "then": {"properties": {
      "analyzer": {"required": ["subpixelPeakModel", "subpixelReverseVerification"]},
      "pairs": {"items": {"properties": {
        "vectors": {"items": {"required": ["subpixelPeakStatus", "subpixelPeakOffsetPixels", "subpixelReverseVerification"]}}
      }}}
    }}
  }, {
    "if": {"properties": {"analyzer": {"properties": {
      "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-bidir-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-bidir-v1"]}
    }}}},
    "then": {"properties": {"pairs": {"items": {"properties": {
      "vectors": {"items": {"required": ["subpixelReverseErrorPixels"]}}
    }}}}}
  }, {
    "if": {"properties": {"analyzer": {"required": ["projectiveModel"]}}},
    "then": {"properties": {
      "analyzer": {"required": ["projectiveInlierTolerancePixels", "projectiveMaxHypotheses"]},
      "pairs": {"items": {"required": ["projectiveHypothesis"]}}
    }}
  }, {
    "if": {"required": ["temporalTracklets"], "properties": {
      "temporalTracklets": {"properties": {"method": {"enum": ["mutual-nearest-adjacent-endpoint-motion-gated-v1", "mutual-nearest-adjacent-endpoint-motion-gated-appearance-gated-v1"]}}}
    }},
    "then": {"properties": {"temporalTracklets": {
      "required": ["motionMinimumTolerancePixels", "motionRelativeTolerance", "motionInconsistentLinkCandidates"],
      "properties": {"tracklets": {"items": {"properties": {"observations": {
        "items": {"required": ["motionResidualPixels", "motionAllowancePixels"]}
      }}}}}
    }}}
  }, {
    "if": {"required": ["temporalTracklets"], "properties": {"temporalTracklets": {
      "properties": {"method": {"enum": ["mutual-nearest-adjacent-endpoint-appearance-gated-v1", "mutual-nearest-adjacent-endpoint-motion-gated-appearance-gated-v1"]}}
    }}},
    "then": {"properties": {"temporalTracklets": {
      "required": ["appearancePatchSizePixels", "appearanceMaxEndpointShiftPixels", "appearanceMinCorrelation", "appearanceInconsistentLinkCandidates", "appearanceUnobservableLinkCandidates"],
      "properties": {"tracklets": {"items": {"properties": {"observations": {
        "items": {"required": ["twoHopAppearanceCorrelation", "twoHopAppearanceShiftPixels"]}
      }}}}}
    }}}
  }],
  "properties": {
    "schemaVersion": {"const": "kumiki.sparse-flow.v1"},
    "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceStreamIndex": {"type": "integer", "minimum": 0},
    "sourceTimebase": {"$ref": "#/$defs/rational"},
    "scanWindowSeconds": {"type": "integer", "minimum": 1, "maximum": 20},
    "coverage": {"const": "bounded-from-start-not-necessarily-full-video"},
    "analyzer": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "numpyVersion", "ffmpegExecutable", "ffprobeExecutable", "resolution", "maxSamples", "maxCornersPerFramePair", "searchRadiusPixels", "patchSizePixels", "minimumAppearanceCorrelation", "roundtripTolerancePixels", "consensusTolerancePixels", "cutThreshold", "observedFrameCount", "missingSourcePtsCount", "selection", "calibratedConfidence", "limits"],
      "properties": {
        "method": {"enum": ["shi-tomasi-approx-patch-ncc-fb-consensus-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-subpixel-bidir-v1", "shi-tomasi-approx-patch-ncc-fb-consensus-affine-pyramid2-subpixel-bidir-v1"]},
        "numpyVersion": {"type": "string", "minLength": 1},
        "ffmpegExecutable": {"type": "string", "minLength": 1},
        "ffprobeExecutable": {"type": "string", "minLength": 1},
        "resolution": {"type": "object", "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 64, "maximum": 240},
                         "height": {"type": "integer", "minimum": 36, "maximum": 135}}},
        "maxSamples": {"type": "integer", "minimum": 5, "maximum": 40},
        "maxCornersPerFramePair": {"type": "integer", "minimum": 4, "maximum": 64},
        "searchRadiusPixels": {"type": "integer", "minimum": 2, "maximum": 12},
        "pyramidLevels": {"const": 2},
        "coarseRefinementRadiusPixels": {"const": 2},
        "subpixelPeakModel": {"const": "separable-3-point-ncc-parabola-v1"},
        "subpixelReverseVerification": {"enum": ["integer-peak-only", "fractional-bilinear-patch-check"]},
        "projectiveModel": {"const": "normalized-dlt-bounded-ransac-v1"},
        "projectiveInlierTolerancePixels": {"const": 1.5},
        "projectiveMaxHypotheses": {"const": 256},
        "patchSizePixels": {"const": 9},
        "minimumAppearanceCorrelation": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "roundtripTolerancePixels": {"const": 1.5},
        "consensusTolerancePixels": {"const": 1.5},
        "affineInlierTolerancePixels": {"const": 1.5},
        "affineMaxHypotheses": {"const": 384},
        "cutThreshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "observedFrameCount": {"type": "integer", "minimum": 2},
        "missingSourcePtsCount": {"type": "integer", "minimum": 0},
        "selection": {"const": "uniform-original-pts-nearest-frame"},
        "calibratedConfidence": {"const": false},
        "limits": {"type": "string", "minLength": 1}
      }
    },
    "cutCandidatePts": {"type": "array", "items": {"type": "integer"}},
    "samples": {"type": "array", "minItems": 2, "maxItems": 40,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["sampleOrdinal", "sourcePts", "sourceSeconds"],
        "properties": {"sampleOrdinal": {"type": "integer", "minimum": 0},
                       "sourcePts": {"type": "integer"},
                       "sourceSeconds": {"$ref": "#/$defs/rational"}}}},
    "temporalTracklets": {"$ref": "#/$defs/temporalTracklets"},
    "pairs": {"type": "array", "minItems": 1, "maxItems": 39,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["startPts", "endPts", "deltaTimeSeconds", "status", "detectedCorners", "rejected", "vectors", "consensus"],
        "properties": {
          "startPts": {"type": "integer"}, "endPts": {"type": "integer"},
          "deltaTimeSeconds": {"$ref": "#/$defs/rational"},
          "status": {"enum": ["cut-boundary", "insufficient-consensus", "ambiguous-dominant-group", "multiple-image-translations", "single-image-translation-candidate"]},
          "detectedCorners": {"type": "integer", "minimum": 0, "maximum": 64},
          "rejected": {"type": "object", "additionalProperties": false,
            "required": ["low-texture", "forward-failed", "backward-failed", "roundtrip-inconsistent"],
            "properties": {"low-texture": {"type": "integer", "minimum": 0},
                           "forward-failed": {"type": "integer", "minimum": 0},
                           "backward-failed": {"type": "integer", "minimum": 0},
                           "roundtrip-inconsistent": {"type": "integer", "minimum": 0}}},
          "vectors": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/vector"}},
          "consensus": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/consensus"}]},
          "geometryHypothesis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/geometry"}]},
          "projectiveHypothesis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/projective"}]}
        }
      }
    }
  },
  "$defs": {
    "temporalTracklets": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "method", "linkTolerancePixels", "ambiguityMarginPixels", "minConsecutivePairs", "calibratedConfidence", "semanticIdentityVerified", "singlePairCandidatesDiscarded", "tracklets"],
      "properties": {
        "status": {"enum": ["candidate-only", "insufficient-continuity"]},
        "method": {"enum": ["mutual-nearest-adjacent-endpoint-v1", "mutual-nearest-adjacent-endpoint-motion-gated-v1", "mutual-nearest-adjacent-endpoint-appearance-gated-v1", "mutual-nearest-adjacent-endpoint-motion-gated-appearance-gated-v1"]},
        "linkTolerancePixels": {"const": 2.0},
        "ambiguityMarginPixels": {"const": 0.5},
        "motionMinimumTolerancePixels": {"const": 2.5},
        "motionRelativeTolerance": {"const": 0.6},
        "motionInconsistentLinkCandidates": {"type": "integer", "minimum": 0},
        "appearancePatchSizePixels": {"const": 9},
        "appearanceMaxEndpointShiftPixels": {"const": 1},
        "appearanceMinCorrelation": {"const": 0.62},
        "appearanceInconsistentLinkCandidates": {"type": "integer", "minimum": 0},
        "appearanceUnobservableLinkCandidates": {"type": "integer", "minimum": 0},
        "minConsecutivePairs": {"const": 2},
        "calibratedConfidence": {"const": false},
        "semanticIdentityVerified": {"const": false},
        "singlePairCandidatesDiscarded": {"type": "integer", "minimum": 0},
        "tracklets": {"type": "array", "maxItems": 2496, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "pairCount", "endReason", "observations"],
          "properties": {
            "id": {"type": "string", "pattern": "^tracklet-[0-9]{4,}$"},
            "pairCount": {"type": "integer", "minimum": 2, "maximum": 39},
            "endReason": {"enum": ["cut-boundary", "nonadjacent-or-missing-observation", "no-safe-match", "scan-end"]},
            "kinematics": {"$ref": "#/$defs/trackletKinematics"},
            "observations": {"type": "array", "minItems": 2, "maxItems": 39,
              "items": {"type": "object", "additionalProperties": false,
                "required": ["pairIndex", "vectorIndex", "startPts", "endPts", "startPixels", "endPixels", "handoffErrorPixels", "group"],
                "properties": {
                  "pairIndex": {"type": "integer", "minimum": 0, "maximum": 38},
                  "vectorIndex": {"type": "integer", "minimum": 0, "maximum": 63},
                  "startPts": {"type": "integer"},
                  "endPts": {"type": "integer"},
                  "startPixels": {"$ref": "#/$defs/trackPoint"},
                  "endPixels": {"$ref": "#/$defs/trackPoint"},
                  "handoffErrorPixels": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
                  "motionResidualPixels": {"type": ["number", "null"], "minimum": 0},
                  "motionAllowancePixels": {"type": ["number", "null"], "minimum": 0},
                  "twoHopAppearanceCorrelation": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
                  "twoHopAppearanceShiftPixels": {"oneOf": [{"type": "null"}, {
                    "type": "object", "additionalProperties": false, "required": ["dx", "dy"],
                    "properties": {"dx": {"type": "integer", "minimum": -1, "maximum": 1},
                                   "dy": {"type": "integer", "minimum": -1, "maximum": 1}}
                  }]},
                  "group": {"enum": ["dominant", "secondary", "unclassified"]}
                }
              }}
          }
        }}
      }
    },
    "trackPoint": {"type": "object", "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "trackletKinematics": {
      "type": "object", "additionalProperties": false,
      "required": ["durationSeconds", "summedImageDisplacementPixels", "observedPathLengthPixels", "meanImageVelocityPixelsPerSecond", "meanImageSpeedPixelsPerSecond", "basis", "calibratedConfidence"],
      "properties": {
        "durationSeconds": {"$ref": "#/$defs/rational"},
        "summedImageDisplacementPixels": {"$ref": "#/$defs/trackVector"},
        "observedPathLengthPixels": {"type": "number", "minimum": 0},
        "meanImageVelocityPixelsPerSecond": {"$ref": "#/$defs/trackVector"},
        "meanImageSpeedPixelsPerSecond": {"type": "number", "minimum": 0},
        "basis": {"const": "observed-pairs-only-no-gap-filling"},
        "calibratedConfidence": {"const": false}
      }
    },
    "trackVector": {"type": "object", "additionalProperties": false,
      "required": ["dx", "dy"],
      "properties": {"dx": {"type": "number"}, "dy": {"type": "number"}}},
    "rational": {"type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"},
                     "denominator": {"type": "integer", "minimum": 1}}},
    "vector": {"type": "object", "additionalProperties": false,
      "required": ["x", "y", "dx", "dy", "forwardCorrelation", "backwardCorrelation", "roundtripErrorPixels", "group"],
      "properties": {"x": {"type": "integer", "minimum": 0},
                     "y": {"type": "integer", "minimum": 0},
                     "dx": {"type": "number"}, "dy": {"type": "number"},
                     "forwardCorrelation": {"type": "number", "minimum": -1, "maximum": 1},
                     "backwardCorrelation": {"type": "number", "minimum": -1, "maximum": 1},
                     "roundtripErrorPixels": {"type": "number", "minimum": 0, "maximum": 1.5},
                     "searchLevel": {"enum": [1, 2]},
                     "subpixelPeakStatus": {"enum": ["candidate-1d-parabola", "integer-fallback"]},
                     "subpixelPeakOffsetPixels": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/subpixelOffset"}]},
                     "subpixelReverseVerification": {"enum": ["integer-peak-only", "fractional-bilinear-patch-checked", "fractional-unavailable-integer-fallback", "fractional-check-failed-integer-fallback"]},
                     "subpixelReverseErrorPixels": {"type": ["number", "null"], "minimum": 0, "maximum": 0.75},
                     "group": {"enum": ["dominant", "secondary", "unclassified"]}}},
    "subpixelOffset": {"type": "object", "additionalProperties": false,
      "required": ["dx", "dy"],
      "properties": {
        "dx": {"type": "number", "minimum": -0.75, "maximum": 0.75},
        "dy": {"type": "number", "minimum": -0.75, "maximum": 0.75}
      }
    },
    "consensus": {"type": "object", "additionalProperties": false,
      "required": ["status", "clusters", "unclassifiedCount"],
      "properties": {"status": {"enum": ["insufficient-consensus", "ambiguous-dominant-group", "multiple-image-translations", "single-image-translation-candidate"]},
                     "clusters": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/cluster"}},
                     "unclassifiedCount": {"type": "integer", "minimum": 0}}},
    "geometry": {"type": "object", "additionalProperties": false,
      "required": ["status", "inliers", "correspondences", "inlierPointIndices", "model"],
      "properties": {
        "status": {"enum": ["insufficient-points", "no-robust-affine-consensus", "unstable-affine-refinement", "insufficient-spatial-support", "implausible-affine-geometry", "translation-sufficient", "affine-image-plane-candidate"]},
        "inliers": {"type": "integer", "minimum": 0, "maximum": 64},
        "correspondences": {"type": "integer", "minimum": 0, "maximum": 64},
        "inlierPointIndices": {"type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}},
        "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/affineModel"}]}
      }
    },
    "projective": {"type": "object", "additionalProperties": false,
      "required": ["status", "inliers", "correspondences", "inlierPointIndices", "model"],
      "properties": {
        "status": {"enum": ["insufficient-points", "no-robust-projective-consensus", "unstable-projective-refinement", "implausible-projective-warp", "insufficient-spatial-support", "affine-sufficient", "projective-image-plane-candidate"]},
        "inliers": {"type": "integer", "minimum": 0, "maximum": 64},
        "correspondences": {"type": "integer", "minimum": 0, "maximum": 64},
        "inlierPointIndices": {"type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}},
        "model": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/projectiveModel"}]}
      }
    },
    "projectiveModel": {"type": "object", "additionalProperties": false,
      "required": ["matrix3x3", "rmsHomographyPixels", "rmsAffinePixels", "inlierFraction", "inlierSpanFraction", "cornerDenominatorRatio", "calibratedConfidence"],
      "properties": {
        "matrix3x3": {"type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number"}}},
        "rmsHomographyPixels": {"type": "number", "minimum": 0},
        "rmsAffinePixels": {"type": "number", "minimum": 0},
        "inlierFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "inlierSpanFraction": {"type": "object", "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1},
                         "y": {"type": "number", "minimum": 0, "maximum": 1}}},
        "cornerDenominatorRatio": {"type": "number", "minimum": 1, "maximum": 4},
        "calibratedConfidence": {"const": false}
      }
    },
    "affineModel": {"type": "object", "additionalProperties": false,
      "required": ["matrix2x3", "translationOnlyPixels", "rmsAffinePixels", "rmsTranslationPixels", "inlierFraction", "inlierSpanFraction", "areaScaleCandidate", "rotationDegreesCandidate", "anisotropyCandidate", "reflectionOrInvalidGeometry", "calibratedConfidence"],
      "properties": {
        "matrix2x3": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "array", "minItems": 3, "maxItems": 3,
                    "items": {"type": "number"}}},
        "translationOnlyPixels": {"type": "object", "additionalProperties": false,
          "required": ["dx", "dy"],
          "properties": {"dx": {"type": "number"}, "dy": {"type": "number"}}},
        "rmsAffinePixels": {"type": "number", "minimum": 0},
        "rmsTranslationPixels": {"type": "number", "minimum": 0},
        "inlierFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "inlierSpanFraction": {"type": "object", "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1},
                         "y": {"type": "number", "minimum": 0, "maximum": 1}}},
        "areaScaleCandidate": {"type": "number", "exclusiveMinimum": 0},
        "rotationDegreesCandidate": {"type": "number"},
        "anisotropyCandidate": {"type": "number", "minimum": 1},
        "reflectionOrInvalidGeometry": {"const": false},
        "calibratedConfidence": {"const": false}
      }
    },
    "cluster": {"type": "object", "additionalProperties": false,
      "required": ["role", "support", "supportFraction", "dxPixels", "dyPixels", "medianResidualPixels", "spatialCellCount", "pointBoundsPixels"],
      "properties": {"role": {"enum": ["dominant", "secondary"]},
                     "support": {"type": "integer", "minimum": 3},
                     "supportFraction": {"type": "number", "minimum": 0, "maximum": 1},
                     "dxPixels": {"type": "number"}, "dyPixels": {"type": "number"},
                     "medianResidualPixels": {"type": "number", "minimum": 0},
                     "spatialCellCount": {"type": "integer", "minimum": 1, "maximum": 48},
                     "pointBoundsPixels": {"type": "object", "additionalProperties": false,
                       "required": ["minX", "minY", "maxX", "maxY"],
                       "properties": {"minX": {"type": "number"}, "minY": {"type": "number"},
                                      "maxX": {"type": "number"}, "maxY": {"type": "number"}}}}}
  }
}
