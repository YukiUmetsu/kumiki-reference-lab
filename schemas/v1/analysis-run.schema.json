{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/analysis-run.schema.json",
  "title": "Kumiki Transactional Analysis Run v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "settings", "sourceTimebase", "coverage", "artifacts", "files", "catalogProposals", "interpretationStatus"],
  "properties": {
    "schemaVersion": {"const": "kumiki.analysis-run.v1"},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSha256", "streamIndex", "seconds", "thumbnails", "motion", "roi", "samples", "width", "height", "cutThreshold", "ffmpeg", "ffprobe", "rightsStatus", "versions"],
      "allOf": [
        {"if": {"required": ["sparseFlow"]},
         "then": {"required": ["sparseSamples", "sparsePoints", "sparseRadius", "sparseCorrelation"],
                  "properties": {"seconds": {"maximum": 20}, "width": {"maximum": 240},
                                 "height": {"maximum": 135},
                                 "versions": {"required": ["sparseFlow"]}}}},
        {"if": {"not": {"required": ["sparseFlow"]}},
         "then": {"not": {"anyOf": [{"required": ["sparseSamples"]},
                                     {"required": ["sparsePoints"]},
                                     {"required": ["sparseRadius"]},
                                     {"required": ["sparseCorrelation"]},
                                     {"required": ["sparsePyramidLevels"]},
                                     {"required": ["sparseSubpixelRefinement"]},
                                     {"required": ["sparseSubpixelReverseCheck"]},
                                     {"required": ["sparseLkRefinement"]},
                                     {"required": ["sparseQuadrantConsistency"]},
                                     {"required": ["sparseProjectiveHypotheses"]},
                                     {"required": ["sparseModelValidation"]},
                                     {"required": ["sparseTrackletMotionConsistency"]},
                                     {"required": ["sparseTrackletAppearanceConsistency"]}]},
                  "properties": {"versions": {"not": {"required": ["sparseFlow"]}}}}},
        {"if": {"required": ["denseFlow"]},
         "then": {"required": ["denseSamples", "denseGridStep"],
                  "properties": {"seconds": {"maximum": 20}, "width": {"maximum": 240},
                                 "height": {"maximum": 135},
                                 "versions": {"required": ["denseFlow"]}}}},
        {"if": {"not": {"required": ["denseFlow"]}},
         "then": {"not": {"anyOf": [{"required": ["denseSamples"]},
                                     {"required": ["denseGridStep"]}]},
                  "properties": {"versions": {"not": {"required": ["denseFlow"]}}}}},
        {"if": {"required": ["appearance"]},
         "then": {"required": ["appearanceSamples"],
                  "properties": {"seconds": {"maximum": 20}, "width": {"maximum": 240},
                                 "height": {"maximum": 135},
                                 "versions": {"required": ["appearance"]}}}},
        {"if": {"not": {"required": ["appearance"]}},
         "then": {"not": {"required": ["appearanceSamples"]},
                  "properties": {"versions": {"not": {"required": ["appearance"]}}}}}
      ],
      "properties": {
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "streamIndex": {"type": "integer", "minimum": 0},
        "seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "thumbnails": {"type": "integer", "minimum": 2, "maximum": 24},
        "motion": {"type": "boolean"},
        "sparseFlow": {"const": true},
        "sparseSamples": {"type": "integer", "minimum": 5, "maximum": 40},
        "sparsePoints": {"type": "integer", "minimum": 4, "maximum": 64},
        "sparseRadius": {"type": "integer", "minimum": 2, "maximum": 12},
        "sparseCorrelation": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "sparsePyramidLevels": {"const": 2},
        "sparseSubpixelRefinement": {"const": true},
        "sparseSubpixelReverseCheck": {"const": true},
        "sparseLkRefinement": {"const": true},
        "sparseQuadrantConsistency": {"const": true},
        "sparseProjectiveHypotheses": {"const": true},
        "sparseModelValidation": {"const": true},
        "sparseTrackletMotionConsistency": {"const": true},
        "sparseTrackletAppearanceConsistency": {"const": true},
        "denseFlow": {"const": true},
        "denseSamples": {"type": "integer", "minimum": 5, "maximum": 40},
        "denseGridStep": {"type": "integer", "minimum": 8, "maximum": 24},
        "appearance": {"const": true},
        "appearanceSamples": {"type": "integer", "minimum": 5, "maximum": 40},
        "roi": {"type": ["array", "null"], "minItems": 4, "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "samples": {"type": "integer", "minimum": 5, "maximum": 120},
        "width": {"type": "integer", "minimum": 64, "maximum": 320},
        "height": {"type": "integer", "minimum": 36, "maximum": 180},
        "cutThreshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "ffmpeg": {"type": "string", "minLength": 1},
        "ffprobe": {"type": "string", "minLength": 1},
        "rightsStatus": {"type": "string"},
        "versions": {"type": "object", "additionalProperties": false,
          "required": ["run", "source", "frames", "cuts", "contact", "motion", "roi"],
          "properties": {
            "run": {"const": "kumiki.analysis-run.v1"},
            "source": {"type": "string"},
            "frames": {"type": "string"},
            "cuts": {"type": "string"},
            "contact": {"type": "string"},
            "motion": {"type": "string"},
            "sparseFlow": {"const": "kumiki.sparse-flow.v1"},
            "denseFlow": {"const": "kumiki.dense-flow.v1"},
            "appearance": {"const": "kumiki.appearance.v1"},
            "roi": {"type": "string"}
          }
        }
      }
    },
    "sourceTimebase": {"type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"},
                     "denominator": {"type": "integer", "minimum": 1}}},
    "coverage": {"const": "bounded-from-start-not-necessarily-full-video"},
    "artifacts": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "minLength": 1}},
    "files": {"type": "array", "minItems": 7, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
                     "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }},
    "catalogProposals": {"const": []},
    "interpretationStatus": {"const": "not-performed"}
  }
}
