{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/appearance.schema.json",
  "title": "Kumiki Display-Referred Video Appearance v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "sourceStreamIndex", "sourceTimebase", "scanWindowSeconds", "coverage", "analyzer", "cutCandidatePts", "samples", "changes"],
  "properties": {
    "schemaVersion": {"const": "kumiki.appearance.v1"},
    "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceStreamIndex": {"type": "integer", "minimum": 0},
    "sourceTimebase": {"$ref": "#/$defs/rational"},
    "scanWindowSeconds": {"type": "integer", "minimum": 1, "maximum": 20},
    "coverage": {"const": "bounded-from-start-not-necessarily-full-video"},
    "analyzer": {"type": "object", "additionalProperties": false,
      "required": ["method", "numpyVersion", "ffmpegExecutable", "ffprobeExecutable", "resolution", "pixelFormat", "maxSamples", "cutThreshold", "observedFrameCount", "missingSourcePtsCount", "selection", "physicalPhotometry", "calibratedConfidence", "limits"],
      "properties": {
        "method": {"const": "rgb-display-proxy-statistics-v1"},
        "numpyVersion": {"type": "string", "minLength": 1},
        "ffmpegExecutable": {"type": "string", "minLength": 1},
        "ffprobeExecutable": {"type": "string", "minLength": 1},
        "resolution": {"type": "object", "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 64, "maximum": 240},
                         "height": {"type": "integer", "minimum": 36, "maximum": 135}}},
        "pixelFormat": {"const": "ffmpeg-rgb24"},
        "maxSamples": {"type": "integer", "minimum": 5, "maximum": 40},
        "cutThreshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "observedFrameCount": {"type": "integer", "minimum": 2},
        "missingSourcePtsCount": {"type": "integer", "minimum": 0},
        "selection": {"const": "uniform-original-pts-nearest-frame"},
        "physicalPhotometry": {"const": false},
        "calibratedConfidence": {"const": false},
        "limits": {"type": "string", "minLength": 1}
      }
    },
    "cutCandidatePts": {"type": "array", "items": {"type": "integer"}},
    "samples": {"type": "array", "minItems": 2, "maxItems": 40,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["sampleOrdinal", "sourcePts", "sourceSeconds", "appearance"],
        "properties": {"sampleOrdinal": {"type": "integer", "minimum": 0},
                       "sourcePts": {"type": "integer"},
                       "sourceSeconds": {"$ref": "#/$defs/rational"},
                       "appearance": {"$ref": "#/$defs/appearance"}}}},
    "changes": {"type": "array", "minItems": 1, "maxItems": 39,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["startPts", "endPts", "deltaTimeSeconds", "status", "meanLumaProxyDelta", "meanRgbDelta", "hueHistogramTotalVariation"],
        "properties": {"startPts": {"type": "integer"}, "endPts": {"type": "integer"},
                       "deltaTimeSeconds": {"$ref": "#/$defs/rational"},
                       "status": {"enum": ["cut-boundary", "measured-display-appearance-change"]},
                       "meanLumaProxyDelta": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
                       "meanRgbDelta": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 3, "maxItems": 3,
                                          "items": {"type": "number", "minimum": -1, "maximum": 1}}]},
                       "hueHistogramTotalVariation": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}}
  },
  "$defs": {
    "rational": {"type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"},
                     "denominator": {"type": "integer", "minimum": 1}}},
    "fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "rgb": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/fraction"}},
    "appearance": {"type": "object", "additionalProperties": false,
      "required": ["meanRgb", "meanLumaProxy", "medianLumaProxy", "lumaP10", "lumaP90", "lumaContrastP90MinusP10", "shadowPixelFraction", "brightPixelFraction", "brightPixelCentroid", "meanSaturation", "chromaticPixelFraction", "hueHistogram12", "dominantRgbBins", "spatialGrid3x3"],
      "properties": {
        "meanRgb": {"$ref": "#/$defs/rgb"},
        "meanLumaProxy": {"$ref": "#/$defs/fraction"},
        "medianLumaProxy": {"$ref": "#/$defs/fraction"},
        "lumaP10": {"$ref": "#/$defs/fraction"},
        "lumaP90": {"$ref": "#/$defs/fraction"},
        "lumaContrastP90MinusP10": {"$ref": "#/$defs/fraction"},
        "shadowPixelFraction": {"$ref": "#/$defs/fraction"},
        "brightPixelFraction": {"$ref": "#/$defs/fraction"},
        "brightPixelCentroid": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                                  "required": ["x", "y"],
                                  "properties": {"x": {"$ref": "#/$defs/fraction"}, "y": {"$ref": "#/$defs/fraction"}}}]},
        "meanSaturation": {"$ref": "#/$defs/fraction"},
        "chromaticPixelFraction": {"$ref": "#/$defs/fraction"},
        "hueHistogram12": {"type": "array", "minItems": 12, "maxItems": 12,
                           "items": {"$ref": "#/$defs/fraction"}},
        "dominantRgbBins": {"type": "array", "maxItems": 5,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["rgbApprox", "pixelFraction"],
            "properties": {"rgbApprox": {"type": "array", "minItems": 3, "maxItems": 3,
                                         "items": {"type": "integer", "minimum": 0, "maximum": 255}},
                           "pixelFraction": {"$ref": "#/$defs/fraction"}}}},
        "spatialGrid3x3": {"type": "array", "minItems": 9, "maxItems": 9,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["row", "column", "meanLumaProxy", "lumaStdDev", "brightPixelFraction"],
            "properties": {"row": {"type": "integer", "minimum": 0, "maximum": 2},
                           "column": {"type": "integer", "minimum": 0, "maximum": 2},
                           "meanLumaProxy": {"$ref": "#/$defs/fraction"},
                           "lumaStdDev": {"$ref": "#/$defs/fraction"},
                           "brightPixelFraction": {"$ref": "#/$defs/fraction"}}}}
      }
    }
  }
}
