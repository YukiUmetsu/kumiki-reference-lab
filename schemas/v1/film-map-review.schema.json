{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v1/film-map-review.schema.json",
  "title": "Immutable PTS-verified source and authored FD1 render still pairs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "qualityVerdict", "settings", "pairs", "files"],
  "properties": {
    "schemaVersion": {"const": "kumiki.film-map-review.v1"},
    "status": {"const": "verified-pts-paired-stills"},
    "qualityVerdict": {"const": "not-performed"},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewMapSha256", "filmDocumentSha256", "referenceVideoSha256", "renderVideoSha256", "sourceStreamIndex", "renderStreamIndex", "seconds", "width", "ffmpeg", "ffprobe", "pairedIdentities", "method"],
      "properties": {
        "reviewMapSha256": {"$ref": "#/$defs/sha"},
        "filmDocumentSha256": {"$ref": "#/$defs/sha"},
        "referenceVideoSha256": {"$ref": "#/$defs/sha"},
        "renderVideoSha256": {"$ref": "#/$defs/sha"},
        "sourceStreamIndex": {"type": "integer", "minimum": 0},
        "renderStreamIndex": {"type": "integer", "minimum": 0},
        "seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "width": {"type": "integer", "minimum": 128, "maximum": 800},
        "ffmpeg": {"type": "string", "minLength": 1},
        "ffprobe": {"type": "string", "minLength": 1},
        "pairedIdentities": {"$ref": "#/$defs/pairs"},
        "method": {"const": "exact-source-pts-and-render-ordinal-with-encoded-pts-assertion-v1"}
      }
    },
    "pairs": {"$ref": "#/$defs/pairs"},
    "files": {
      "type": "array", "minItems": 3, "maxItems": 25,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(index\\.html|(?:source|film)/frame-[0-9]{3}\\.jpg)$"},
          "sha256": {"$ref": "#/$defs/sha"}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "pairs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pair"}},
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "relationship", "note", "source", "film"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "relationship": {"enum": ["inspired-by", "visual-analogy", "intended-match"]},
        "note": {"type": "string", "minLength": 8, "maxLength": 2000},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["pts", "seconds", "image"],
          "properties": {
            "pts": {"type": "integer"},
            "seconds": {"$ref": "#/$defs/rational"},
            "image": {"type": "string", "pattern": "^source/frame-[0-9]{3}\\.jpg$"}
          }
        },
        "film": {
          "type": "object", "additionalProperties": false,
          "required": ["frame", "pts", "seconds", "image"],
          "properties": {
            "frame": {"type": "integer", "minimum": 0},
            "pts": {"type": "integer"},
            "seconds": {"$ref": "#/$defs/rational"},
            "image": {"type": "string", "pattern": "^film/frame-[0-9]{3}\\.jpg$"}
          }
        }
      }
    }
  }
}
