{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YukiUmetsu/kumiki-reference-lab/blob/main/schemas/v2/roi-track.schema.json",
  "title": "Kumiki Manually Resegmented ROI Track v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "sourceStreamIndex", "sourceTimebase", "scanWindowSeconds", "coverage", "analyzer", "cutCandidatePts", "observations"],
  "properties": {
    "schemaVersion": {"const": "kumiki.roi-track.v2"},
    "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceStreamIndex": {"type": "integer", "minimum": 0},
    "sourceTimebase": {"$ref": "#/$defs/rational"},
    "scanWindowSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "coverage": {"const": "bounded-from-start-not-necessarily-full-video"},
    "analyzer": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "numpyVersion", "ffmpegExecutable", "ffprobeExecutable", "seedBoxNormalized", "analysisResolution", "maxSamples", "searchRadiusPixels", "minimumAppearanceCorrelation", "cutThreshold", "observedFrameCount", "missingSourcePtsCount", "calibratedConfidence", "manualReseeds", "identityLinkStatus", "limits"],
      "allOf": [{"if": {"required": ["manualReseeds"]}, "then": {"required": ["identityLinkStatus"]}}],
      "properties": {
        "method": {"const": "normalized-template-correlation-v1"},
        "numpyVersion": {"type": "string", "minLength": 1},
        "ffmpegExecutable": {"type": "string", "minLength": 1},
        "ffprobeExecutable": {"type": "string", "minLength": 1},
        "seedBoxNormalized": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "analysisResolution": {"type": "object", "additionalProperties": false,
          "required": ["width", "height"], "properties": {
            "width": {"type": "integer", "minimum": 64, "maximum": 320},
            "height": {"type": "integer", "minimum": 36, "maximum": 180}
          }
        },
        "maxSamples": {"type": "integer", "minimum": 5, "maximum": 120},
        "searchRadiusPixels": {"type": "integer", "minimum": 1, "maximum": 48},
        "minimumAppearanceCorrelation": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "cutThreshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "observedFrameCount": {"type": "integer", "minimum": 2},
        "missingSourcePtsCount": {"type": "integer", "minimum": 0},
        "calibratedConfidence": {"const": false},
        "manualReseeds": {"type": "array", "minItems": 1, "maxItems": 16,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["sourcePts", "box"],
            "properties": {"sourcePts": {"type": "integer"},
              "box": {"type": "array", "minItems": 4, "maxItems": 4,
                "items": {"type": "number", "minimum": 0, "maximum": 1}}}}},
        "identityLinkStatus": {"const": "not-established"},
        "limits": {"type": "string"}
      }
    },
    "cutCandidatePts": {"type": "array", "items": {"type": "integer"}},
    "observations": {
      "type": "array", "minItems": 2, "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sampleOrdinal", "sourcePts", "sourceSeconds", "status", "boxPixels", "boxNormalized", "displacementPixels", "appearanceCorrelation", "peakMargin", "segmentIndex"],
        "properties": {
          "sampleOrdinal": {"type": "integer", "minimum": 0},
          "sourcePts": {"type": "integer"},
          "sourceSeconds": {"$ref": "#/$defs/rational"},
          "status": {"enum": ["seeded", "manual-reseed", "matched-template", "lost-low-correlation", "ambiguous-multiple-matches", "unobservable-low-texture", "out-of-frame", "cut-boundary", "not-tracked-after-loss", "not-tracked-after-cut"]},
          "segmentIndex": {"type": ["integer", "null"], "minimum": 0},
          "boxPixels": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/box"}]},
          "boxNormalized": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/box"}]},
          "displacementPixels": {"oneOf": [{"type": "null"}, {
            "type": "object", "additionalProperties": false,
            "required": ["dx", "dy"], "properties": {
              "dx": {"type": "number"}, "dy": {"type": "number"}
            }
          }]},
          "appearanceCorrelation": {"type": ["number", "null"]},
          "peakMargin": {"type": ["number", "null"]}
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"},
                     "denominator": {"type": "integer", "minimum": 1}}
    },
    "box": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
